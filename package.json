{
  "name": "lattice-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A dense, calm design system for operational consoles. Source-first React components for dashboards, devices and settings.",
  "homepage": "https://anilams.github.io/lattice-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anilams/lattice-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Anilams/lattice-ui/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "radix-ui",
    "dashboard",
    "console",
    "shadcn"
  ],
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    }
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build && node scripts/copy-fallback.mjs",
    "build:lib": "tsup src/index.ts --format esm,cjs --out-dir dist-lib --external react --external react-dom --external react/jsx-runtime && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "registry": "node scripts/build-registry.mjs",
    "tokens": "node scripts/export-tokens.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
